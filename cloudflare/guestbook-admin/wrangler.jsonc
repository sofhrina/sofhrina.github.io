{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sofhrina-guestbook-admin",
  "main": "src/index.js",
  "compatibility_date": "2026-08-11",
  "workers_dev": false,
  "routes": [
    { "pattern": "guestbook-admin.sofhrina.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ADMIN_EMAIL": "sophiaisfhr0429@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sofhrina-guestbook",
      "database_id": "775746a9-6055-472f-bbd3-015edf49613b"
    }
  ]
}
